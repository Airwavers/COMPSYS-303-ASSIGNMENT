scchart VersionA_Task2 {

  input bool tick = false
  input bool NSraised
  input bool EWraised

  output int NS_red = 0
  output int NS_yellow = 0
  output int NS_green = 0

  output int EW_red = 0
  output int EW_yellow = 0
  output int EW_green = 0

  output int NS_ped_red = 0
  output int NS_ped_green = 0
  output int EW_ped_red = 0
  output int EW_ped_green = 0

  bool NS_request = false
  bool EW_request = false

  bool NS_done = false
  bool EW_done = false

  const int t1 = 5000
  const int t2 = 2000
  const int t3 = 1000
  const int t4 = 5000
  const int t5 = 2000
  const int t6 = 1000

  const int ped_time = 4000
  int elapsed = 0;


  region {

    initial state NS_Green {
      entry do elapsed = 0
      entry do NS_red = 0
      entry do NS_yellow = 0
      entry do NS_green = 1

      entry do EW_red = 1
      entry do EW_yellow = 0
      entry do EW_green = 0

      entry do NS_ped_red = 1
      entry do NS_ped_green = 0
      entry do EW_ped_red = 1
      entry do EW_ped_green = 0
      during if tick do elapsed = elapsed + 1
    }

    if EW_done do EW_done = false go to NS_Green

    if elapsed >= t1 do
      elapsed = 0
      go to NS_Yellow


    state NS_Yellow {
      entry do elapsed = 0
      entry do NS_red = 0
      entry do NS_yellow = 1
      entry do NS_green = 0

      entry do EW_red = 1
      entry do EW_yellow = 0
      entry do EW_green = 0

      entry do NS_ped_red = 1
      entry do NS_ped_green = 0
      entry do EW_ped_red = 1
      entry do EW_ped_green = 0
      during if tick do elapsed = elapsed + 1
    }

    if elapsed >= t2 do elapsed = 0 go to All_Red


    state All_Red {
      entry do elapsed = 0
      entry do NS_red = 1
      entry do NS_yellow = 0
      entry do NS_green = 0

      entry do EW_red = 1
      entry do EW_yellow = 0
      entry do EW_green = 0

      entry do NS_ped_red = 1
      entry do NS_ped_green = 0
      entry do EW_ped_red = 1
      entry do EW_ped_green = 0
      during if tick do elapsed = elapsed + 1
    }

    if NS_request go to NS_Green_Ped
    if elapsed >= t3 && !NS_request do elapsed = 0 go to EW_Green

    state NS_Green_Ped {
      entry do elapsed = 0
      entry do NS_red = 1
      entry do NS_yellow = 0
      entry do NS_green = 0

      entry do EW_red = 1
      entry do EW_yellow = 0
      entry do EW_green = 0

      entry do NS_ped_red = 0
      entry do NS_ped_green = 1
      entry do EW_ped_red = 1
      entry do EW_ped_green = 0
      during if tick do elapsed = elapsed + 1
    }

    if elapsed >= ped_time do
         elapsed = 0;
          NS_done = true
          go to EW_Green


    state EW_Green {
      entry do elapsed = 0
      entry do NS_red = 1
      entry do NS_yellow = 0
      entry do NS_green = 0

      entry do EW_red = 0
      entry do EW_yellow = 0
      entry do EW_green = 1

      entry do NS_ped_red = 1
      entry do NS_ped_green = 0
      entry do EW_ped_red = 1
      entry do EW_ped_green = 0
      during if tick do elapsed = elapsed + 1
    }

    if NS_done do NS_done = false go to EW_Green

    if elapsed >= t4 do
        elapsed = 0
        go to EW_Yellow


    state EW_Yellow {
      entry do elapsed = 0
      entry do NS_red = 1
      entry do NS_yellow = 0
      entry do NS_green = 0

      entry do EW_red = 0
      entry do EW_yellow = 1
      entry do EW_green = 0

      entry do NS_ped_red = 1
      entry do NS_ped_green = 0
      entry do EW_ped_red = 1
      entry do EW_ped_green = 0
      during if tick do elapsed = elapsed + 1
    }

    if elapsed >= t5 do elapsed = 0 go to All_Red_2


    state All_Red_2 {
      entry do elapsed = 0
      entry do NS_red = 1
      entry do NS_yellow = 0
      entry do NS_green = 0

      entry do EW_red = 1
      entry do EW_yellow = 0
      entry do EW_green = 0

      entry do NS_ped_red = 0
      entry do NS_ped_green = 0
      entry do EW_ped_red = 0
      entry do EW_ped_green = 0
      during if tick do elapsed = elapsed + 1
    }

    if EW_request go to EW_Green_Ped
    if elapsed >= t6 && !EW_request do elapsed = 0 go to NS_Green

    state EW_Green_Ped {
      entry do elapsed = 0
      entry do NS_red = 1
      entry do NS_yellow = 0
      entry do NS_green = 0

      entry do EW_red = 1
      entry do EW_yellow = 0
      entry do EW_green = 0

      entry do NS_ped_red = 1
      entry do NS_ped_green = 0
      entry do EW_ped_red = 0
      entry do EW_ped_green = 1
      during if tick do elapsed = elapsed + 1
    }

    if elapsed >= ped_time do
          elapsed = 0;
          EW_done = true
          go to NS_Green
  }

  // NS pedestrian request latch
  region {
    initial state NS_idle {
        entry do NS_request = false
    }

    if NSraised go to NS_waiting

    state NS_waiting {
        entry do NS_request = true
    }

    if NS_done go to NS_idle
  }

  // EW pedestrian request latch
  region {
    initial state EW_idle {
        entry do EW_request = false
    }

    if EWraised go to EW_waiting

    state EW_waiting {
        entry do EW_request = true
    }

    if EW_done go to EW_idle
  }
}