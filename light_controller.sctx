scchart VersionB {

region {

input bool tick = false

output int NS_red = 0
output int NS_yellow = 0
output int NS_green = 0

output int EW_red = 0
output int EW_yellow = 0
output int EW_green = 0

const int t1 = 5000
const int t2 = 2000
const int t3 = 1000
const int t4 = 5000
const int t5 = 2000
const int t6 = 1000

int elapsed = 0

initial state NS_Green {
  entry do {
    elapsed = 0
    NS_red = 0
    NS_yellow = 0
    NS_green = 1
    EW_red = 1
    EW_yellow = 0
    EW_green = 0
  }

  during if tick do elapsed = elapsed + 1
}

  if elapsed >= t1 go to NS_Yellow

state NS_Yellow {
  entry do {
    elapsed = 0
    NS_red = 0
    NS_yellow = 1
    NS_green = 0
    EW_red = 1
    EW_yellow = 0
    EW_green = 0
  }

  during if tick do elapsed = elapsed + 1;
}
  if elapsed >= t2 go to All_Red;

state All_Red {
  entry do {
    elapsed = 0
    NS_red = 1
    NS_yellow = 0
    NS_green = 0
    EW_red = 1
    EW_yellow = 0
    EW_green = 0
  }

  during if tick do elapsed = elapsed + 1;
}
  if elapsed >= t3 go to EW_Green;
  
  
state EW_Green {
  entry do {
    elapsed = 0
    NS_red = 1
    NS_yellow = 0
    NS_green = 0
    EW_red = 0
    EW_yellow = 0
    EW_green = 1
  }

  during if tick do elapsed = elapsed + 1;
}
  if elapsed >= t4 go to EW_Yellow;

state EW_Yellow {
  entry do {
    elapsed = 0
    NS_red = 1
    NS_yellow = 0
    NS_green = 0
    EW_red = 0
    EW_yellow = 1
    EW_green = 0
  }

  during if tick do elapsed = elapsed + 1;
}
  if elapsed >= t5 go to All_Red_2;

state All_Red_2 {
  entry do {
    elapsed = 0
    NS_red = 1
    NS_yellow = 0
    NS_green = 0
    EW_red = 1
    EW_yellow = 0
    EW_green = 0
  }

  during if tick do elapsed = elapsed + 1;
}
  if elapsed >= t6 go to NS_Green;

}
}